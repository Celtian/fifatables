{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES6",
    "target": "ES5",
    "lib": ["ES2020", "DOM"],
    "ignoreDeprecations": "6.0",
    "declaration": true,
    "outDir": "./dist/es6",
    "rootDir": "./src",
    "moduleResolution": "node",
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
