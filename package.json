{
  "name": "fifatables",
  "version": "0.2.10",
  "description": "Definition of Fifa Soccer Game tables",
  "scripts": {
    "start": "rimraf dist && tsc-watch --build tsconfig.es5.json --onSuccess 'bun run postbuild'",
    "demo": "tsx ./demo.ts",
    "build": "rimraf dist && tsc --build tsconfig.es6.json && tsc --build tsconfig.es5.json",
    "postbuild": "copyfiles ./package.json ./README.md ./LICENSE ./dist && bun run prepare-dist",
    "test": "vitest run",
    "prepare-dist": "tsx ./scripts/prepare-dist.ts",
    "prepare-yaml": "tsx ./scripts/prepare-yaml.ts",
    "yaml-to-json": "tsx ./scripts/yaml-to-json.ts",
    "husky:install": "husky",
    "gpr:setup": "tsx ./scripts/gpr-setup.ts",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "postversion": "git push && git push --follow-tags",
    "publish:beta": "bun install && bun run build && npm publish --folder dist --tag beta",
    "release:beta": "npm version prerelease -m \"chore(update): prelease %s β\"",
    "release:patch": "git checkout master && npm version patch -m \"chore(update): patch release %s 🐛 \"",
    "release:minor": "git checkout master && npm version minor -m \"chore(update): release %s 🚀\"",
    "release:major": "git checkout master && npm version major -m \"chore(update): major release %s 💥 \"",
    "fix-vulnerabilities": "bun update && bun audit && bunx update-browserslist-db@latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Celtian/fifatables.git"
  },
  "author": {
    "name": "Dominik Hladík",
    "email": "dominik.hladik@seznam.cz"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Celtian/fifatables/issues"
  },
  "homepage": "https://github.com/Celtian/fifatables#readme",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">= 12",
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/byline": "^4.2.36",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "auto-changelog": "^2.6.0",
    "byline": "^5.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^10.8.0",
    "fs-extra": "^11.4.0",
    "husky": "^9.1.7",
    "iconv-lite": "^0.7.3",
    "js-yaml": "^5.2.2",
    "prettier": "^3.9.6",
    "pretty-quick": "^4.2.2",
    "quick-commitlint": "^0.1.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "data",
    "download",
    "football",
    "scraper",
    "soccer",
    "fifatables"
  ],
  "auto-changelog": {
    "remote": "none",
    "commitUrl": "https://github.com/Celtian/fifatables/commit/{id}",
    "issueUrl": "https://github.com/Celtian/fifatables/issues/{id}",
    "mergeUrl": "https://github.com/Celtian/fifatables/pull/{id}",
    "compareUrl": "https://github.com/Celtian/fifatables/compare/{from}...{to}"
  }
}
